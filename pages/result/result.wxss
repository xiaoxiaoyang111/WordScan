.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #F3F4F6;
  padding-bottom: 60rpx;
}

.summary {
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 24rpx;
}

.count {
  color: #4F46E5;
  font-size: 40rpx;
  font-weight: 700;
  padding: 0 8rpx;
}

.legend {
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.legend-line {
  width: 56rpx;
  height: 10rpx;
  border-radius: 5rpx;
  flex-shrink: 0;
}

.legend-words {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.legend-word {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
  background: #F3F4F6;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.legend-relation {
  font-size: 22rpx;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.canvas-wrap {
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.canvas-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.annotated-canvas {
  width: 100%;
  height: 460rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
}

.empty {
  background: #FFF;
  border-radius: 20rpx;
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #6B7280;
}

.btns {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 6rpx 0;
}

.btn.primary {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  color: #FFF;
}

.btn.primary[disabled] {
  background: #C7CBD4;
  color: #FFF;
}

.btn.ghost {
  background: #FFF;
  color: #4F46E5;
  border: 3rpx solid #4F46E5;
}