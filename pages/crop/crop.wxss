.crop-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #111827;
}

.tip {
  padding: 20rpx 32rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.stage {
  flex: 1;
  position: relative;
  overflow: hidden;
  margin: 0 16rpx;
  border-radius: 12rpx;
}

.stage-img {
  width: 100%;
  height: 100%;
}

.sel {
  position: absolute;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.55);
}

.grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.35);
}

.grid-v.g1 { left: 33.3%; }
.grid-v.g2 { left: 66.6%; }

.grid-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.35);
}

.grid-h.g1 { top: 33.3%; }
.grid-h.g2 { top: 66.6%; }

.corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.corner.lt { left: 0; top: 0; transform: translate(-50%, -50%); }
.corner.rt { right: 0; top: 0; transform: translate(50%, -50%); }
.corner.lb { left: 0; bottom: 0; transform: translate(-50%, 50%); }
.corner.rb { right: 0; bottom: 0; transform: translate(50%, 50%); }

.btns {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 48rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 6rpx 0;
  line-height: 2.2;
}

.btn.primary {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  color: #FFF;
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.12);
  color: #E5E7EB;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 600px;
}